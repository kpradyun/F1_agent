# LLM Configuration
# Provider: "ollama" (local, default) or "gemini" (cloud — no Ollama needed)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini fallback (used when LLM_PROVIDER=gemini or Ollama is unavailable)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# API Configuration
OPENF1_API_TIMEOUT=15
OPENF1_BASE_URL=https://api.openf1.org/v1

# Data Configuration
DEFAULT_YEAR=2024
CACHE_DIR=./cache

# Logging
LOG_LEVEL=INFO
LOG_FILE=f1_agent.log

# UI Configuration (for replay)
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
